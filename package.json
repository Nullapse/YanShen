{
  "name": "yanshen-local-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint --cache --cache-location .test-tmp/eslint-cache static scripts tests/frontend",
    "lint:css": "stylelint --cache --cache-location .test-tmp/stylelint-cache \"static/**/*.css\"",
    "test": "node --test --test-isolation=none tests/frontend/*.test.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.0",
    "stylelint": "^16.23.0"
  }
}
